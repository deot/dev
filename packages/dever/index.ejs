<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title><%= title %></title>
	<style>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: #f7f8fb;
		color: #202939;
		-webkit-font-smoothing: antialiased;
	}

	#toolbar {
		position: sticky;
		top: 0;
		z-index: 1;
		background: rgba(255, 255, 255, 0.96);
		border-bottom: 1px solid #e5e8ef;
		backdrop-filter: blur(12px);
	}

	.toolbar-content,
	#wrapper {
		max-width: 1280px;
		margin: 0 auto;
		padding: 20px 28px;
	}

	.toolbar-content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.heading {
		display: grid;
		grid-template-columns: 42px minmax(0, 1fr);
		column-gap: 12px;
		align-items: center;
	}

	.brand {
		display: grid;
		grid-row: span 2;
		place-items: center;
		width: 42px;
		height: 42px;
		background: #4f46e5;
		border-radius: 12px;
		color: #fff;
		font: 600 16px/1 ui-monospace, "SFMono-Regular", Consolas, monospace;
		box-shadow: 0 4px 10px rgba(79, 70, 229, 0.18);
	}

	.heading,
	.search-area,
	#search,
	#files li,
	#files .name {
		min-width: 0;
	}

	h1,
	#files .name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	h1 {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: -0.8px;
		line-height: 1.25;
	}

	.heading p,
	#search-status {
		color: #667085;
		font-size: 12px;
	}

	.heading p {
		margin-top: 4px;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.4px;
		text-transform: uppercase;
	}

	.search-area {
		flex: 0 1 420px;
	}

	.search-box {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 14px;
		background: #f5f6fa;
		border: 1px solid #e5e8ef;
		border-radius: 12px;
	}

	.search-box:focus-within {
		background: #fff;
		border-color: #818cf8;
		box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
	}

	.search-box svg {
		flex: none;
		width: 18px;
		height: 18px;
		color: #8892a4;
	}

	#search {
		width: 100%;
		padding: 12px 0;
		background: transparent;
		border: 0;
		outline: 0;
		color: inherit;
		font: inherit;
	}

	#search::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	#search::placeholder {
		color: #98a1b2;
	}

	#clear-search {
		padding: 5px 8px;
		background: #eaeef4;
		border: 0;
		border-radius: 6px;
		color: #667085;
		font: inherit;
		font-size: 11px;
		font-weight: 500;
		cursor: pointer;
	}

	#clear-search:hover {
		background: #e0e7ff;
		color: #4338ca;
	}

	#clear-search:focus-visible,
	#files a:focus-visible {
		outline: 2px solid #6366f1;
		outline-offset: 3px;
	}

	#search-status {
		min-height: 20px;
		margin-top: 6px;
	}

	#search-status.no-matches {
		color: #b45309;
	}

	#files {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		list-style: none;
	}

	#files a {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 56px;
		padding: 12px 14px;
		background: #fff;
		border: 1px solid #e5e8ef;
		border-radius: 10px;
		color: inherit;
		font: 13px/1.5 ui-monospace, "SFMono-Regular", Consolas, monospace;
		text-decoration: none;
		transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
	}

	.entry-icon {
		flex: none;
		width: 28px;
		height: 28px;
		padding: 5px;
		background: #f3f5f9;
		border: 1px solid #e7ebf2;
		border-radius: 7px;
		color: #7b8599;
	}

	#files a::after {
		content: "\2192";
		margin-left: auto;
		font: 18px/1 sans-serif;
		opacity: 0.4;
	}

	#files a:hover {
		border-color: #c7c5f7;
		box-shadow: 0 3px 12px rgba(79, 70, 229, 0.07);
	}

	#files a.highlight {
		background: #eef2ff;
		border-color: #a5b4fc;
		color: #3730a3;
		box-shadow: inset 3px 0 #6366f1;
	}

	#files a.highlight .entry-icon {
		background: #e0e7ff;
		border-color: #c7d2fe;
		color: #4f46e5;
	}

	@media (max-width: 1000px) {
		#files {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.toolbar-content,
		#wrapper {
			padding: 16px;
		}

		.toolbar-content {
			align-items: stretch;
			flex-direction: column;
			gap: 12px;
		}

		.search-area {
			flex: auto;
		}

		#search {
			font-size: 16px;
		}

		#files {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#files a {
			transition: none;
		}
	}
	</style>
	<script>
	document.addEventListener('DOMContentLoaded', function() {
		const input = document.getElementById('search');
		const clear = document.getElementById('clear-search');
		const status = document.getElementById('search-status');
		const toolbar = document.getElementById('toolbar');
		const files = document.getElementById('files');
		const links = Array.from(files.querySelectorAll('a'));
		let scrollTimer;

		history.scrollRestoration = 'manual';

		function saveState() {
			clearTimeout(scrollTimer);
			history.replaceState({
				...history.state,
				deverDemo: { query: input.value, scrollY: window.scrollY }
			}, '');
		}

		function updateMatches() {
			const query = input.value.trim().toLowerCase();
			const matches = links.filter(function(link) {
				const matched = !!query && link.textContent.toLowerCase().includes(query);
				link.classList.toggle('highlight', matched);
				return matched;
			});
			const count = matches.length;

			clear.hidden = !input.value;
			status.classList.toggle('no-matches', !!query && !count);
			status.textContent = query
				? (count ? count + (count === 1 ? ' match · ' : ' matches · ') + links.length + ' demos' : 'No matches. Try another search.')
				: (links.length ? links.length + ' demos' : 'No demos available.');
			return matches[0];
		}

		function search(event) {
			clearTimeout(scrollTimer);
			const firstMatch = updateMatches();
			if (!firstMatch || event?.isComposing) return;

			scrollTimer = setTimeout(function() {
				const bounds = firstMatch.getBoundingClientRect();
				const top = toolbar.getBoundingClientRect().bottom + 16;
				if (bounds.top < top || bounds.bottom > window.innerHeight - 16) {
					window.scrollBy(0, bounds.top - top);
				}
			}, 150);
		}

		input.addEventListener('input', search);
		input.addEventListener('compositionend', search);
		clear.addEventListener('click', function() {
			input.value = '';
			search();
			input.focus({ preventScroll: true });
		});
		files.addEventListener('click', function(event) {
			if (event.target.closest('a')) saveState();
		});
		window.addEventListener('pagehide', saveState);
		window.addEventListener('pageshow', function() {
			const state = history.state?.deverDemo;
			if (state) input.value = state.query;
			updateMatches();
			if (state) window.scrollTo(0, state.scrollY);
		});
	});
	</script>
</head>

<body>
	<header id="toolbar">
		<div class="toolbar-content">
			<div class="heading">
				<span class="brand" aria-hidden="true">&lt;/&gt;</span>
				<h1><%= title %></h1>
				<p>Demo directory</p>
			</div>
			<div class="search-area">
				<div class="search-box">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="10.5" cy="10.5" r="6.5" />
						<path d="m16 16 4.5 4.5" />
					</svg>
					<input id="search" type="search" placeholder="Search demos by path..." aria-label="Search demos" aria-controls="files" aria-describedby="search-status" autocomplete="off" spellcheck="false" />
					<button id="clear-search" type="button" hidden>Clear</button>
				</div>
				<p id="search-status" role="status" aria-live="polite" aria-atomic="true">Search by demo path</p>
			</div>
		</div>
	</header>
	<main id="wrapper" aria-label="Demo list">
		<ul id="files">
		<% for (var item in pages) { %>
			<li>
				<a href="<%= base %><%= pages[item] %>.html" title="<%= pages[item] %>">
					<svg class="entry-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m8 6-6 6 6 6m8-12 6 6-6 6m-2-14-4 16" />
					</svg>
					<span class="name"><%= pages[item] %></span>
				</a>
			</li>
		<% } %>
		</ul>
	</main>
</body>

</html>
